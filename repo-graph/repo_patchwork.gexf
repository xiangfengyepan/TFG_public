      <node id="agent_patchwork_13" label="AutoFix">
        <attvalues>
          <attvalue for="node_type" value="agent"/>
          <attvalue for="rawSize" value="12.142857142857142"/>
          <attvalue for="agent_name" value="AutoFix"/>
          <attvalue for="agent_type" value="Patcher"/>
          <attvalue for="short_description" value="Users will give you vulnerable code and you will generate a fix based on the provided INSTRUCTION.  Use CallLLM, CommitChanges, CreatePR, ExtractCode, ExtractModelResponse, ModifyCode, PreparePR, PreparePrompt, ScanSemgrep, steps"/>
          <attvalue for="agent_in_repo" value="https://github.com/patched-codes/patchwork/blob/21948cbec44d3b7aec30715923ac7a0cd3fb1155/patchwork/patchflows/AutoFix/AutoFix.py#L44"/>
