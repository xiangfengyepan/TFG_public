          <attvalue for="prompt_text" value="system_prompt=&quot;&quot;&quot;\&#xD;&#xA;You are a senior software engineer tasked to analyze a issue. &#xD;&#xA;Your analysis will be used to guide the junior engineer to resolve this issue. &#xD;&#xA;&quot;&quot;&quot;,"/>
          <attvalue for="prompt_url" value="https://github.com/patched-codes/patchwork/blob/21948cbec44d3b7aec30715923ac7a0cd3fb1155/patchwork/patchflows/ResolveIssue/ResolveIssue.py#L48"/>
