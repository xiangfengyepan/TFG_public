      <node id="prompt_patchwork_3_1" label="HUMAN: user_prompt">
        <attvalues>
          <attvalue for="node_type" value="prompt"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="prompt_type" value="HUMAN"/>
          <attvalue for="prompt_text" value="user_prompt=f&quot;&quot;&quot;&#xD;&#xA;You are a helpful assistant that formats a history of browser actions and conversations into a JSON object.&#xD;&#xA;You are provided with a JSON schema for the history.&#xD;&#xA;Only include the JSON object in your response, nothing else.&#xD;&#xA;&#xD;&#xA;Here is the history:&#xD;&#xA;&lt;history>&#xD;&#xA;{self.history.final_result()}&#xD;&#xA;&lt;/history>&#xD;&#xA;&quot;&quot;&quot;,"/>
          <attvalue for="prompt_url" value="https://github.com/patched-codes/patchwork/blob/21948cbec44d3b7aec30715923ac7a0cd3fb1155/patchwork/steps/BrowserUse/BrowserUse.py#L132"/>
        </attvalues>
        <viz:color r="195" g="93" b="161"/>
        <viz:size value="10"/>
        <viz:position x="1000" y="-600"/>
      </node>
