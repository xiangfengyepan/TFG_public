      <node id="agent_patchwork_7" label="ManageEngineAgent">
        <attvalues>
          <attvalue for="node_type" value="agent"/>
          <attvalue for="rawSize" value="14.285714285714285"/>
          <attvalue for="agent_name" value="ManageEngineAgent"/>
          <attvalue for="agent_type" value="Helper/Proxy"/>
          <attvalue for="short_description" value="goal is to retrieve, create, or modify service desk tickets and related information."/>
          <attvalue for="agent_in_repo" value="https://github.com/patched-codes/patchwork/blob/21948cbec44d3b7aec30715923ac7a0cd3fb1155/patchwork/steps/ManageEngineAgent/ManageEngineAgent.py#L13"/>
