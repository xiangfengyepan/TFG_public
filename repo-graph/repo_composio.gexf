      <node id="agent_composio_1" label="PR Reviewer">
        <attvalues>
          <attvalue for="node_type" value="agent"/>
          <attvalue for="rawSize" value="12.307692307692307"/>
          <attvalue for="agent_name" value="PR Reviewer"/>
          <attvalue for="agent_type" value="Reviewer"/>
          <attvalue for="short_description" value="A PR-Reviewer, an AI code reviewer for GitHub pull requests."/>
          <attvalue for="agent_in_repo" value="https://github.com/ComposioHQ/composio/blob/7831d2c58309f57e31da280c989539baeb48c449/docs/examples/pr-review-agent/agent.py#L18"/>
          <attvalue for="agent_comment" value="- tools from class Composio: https://github.com/ComposioHQ/composio/blob/7831d2c58309f57e31da280c989539baeb48c449/python/composio/sdk.py#L46"/>
        </attvalues>
        <viz:color r="128" g="119" b="203"/>
