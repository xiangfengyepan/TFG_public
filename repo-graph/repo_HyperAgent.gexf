      <node id="agent_HyperAgent_1" label="navigator">
        <attvalues>
          <attvalue for="node_type" value="agent"/>
          <attvalue for="rawSize" value="15"/>
          <attvalue for="agent_name" value="navigator"/>
          <attvalue for="agent_type" value="Localizator"/>
          <attvalue for="short_description" value="expert in finding all relevant information insider a code repository"/>
          <attvalue for="agent_in_repo" value="https://github.com/FSoft-AI4Code/HyperAgent/blob/c3092f2601ab3bf7f890fac2cd5b1290d3f59256/src/hyperagent/agents/plan_seeking.py#L12"/>
          <attvalue for="agent_comment" value="- use jupyter_executor"/>
