      <node id="agent_HyperAgent_4" label="executor">
        <attvalues>
          <attvalue for="node_type" value="agent"/>
          <attvalue for="rawSize" value="15"/>
          <attvalue for="agent_name" value="executor"/>
          <attvalue for="agent_type" value="Helper/Proxy"/>
          <attvalue for="short_description" value="You are a supporting agent in running bash commandlines"/>
          <attvalue for="agent_in_repo" value="https://github.com/FSoft-AI4Code/HyperAgent/blob/c3092f2601ab3bf7f890fac2cd5b1290d3f59256/src/hyperagent/agents/plan_seeking.py#L133"/>
          <attvalue for="agent_comment" value="- use docker_executor"/>
