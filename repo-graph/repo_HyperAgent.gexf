          <attvalue for="agent_in_repo" value="https://github.com/FSoft-AI4Code/HyperAgent/blob/c3092f2601ab3bf7f890fac2cd5b1290d3f59256/src/hyperagent/agents/plan_seeking.py#L194"/>
