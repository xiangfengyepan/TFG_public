          <attvalue for="short_description" value="A coder that uses a custom patch format for code modifications,&#xA;    inspired by the format described in tmp.gpt41edits.txt.&#xA;    Applies patches using logic adapted from the reference apply_patch.py script."/>
          <attvalue for="agent_in_repo" value="https://github.com/Aider-AI/aider/blob/7afaa26f8b8b7b56146f0674d2a67e795b616b7c/aider/coders/patch_coder.py#L210"/>
