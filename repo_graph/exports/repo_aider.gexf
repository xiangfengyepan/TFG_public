        <attvalues>
          <attvalue for="node_type" value="prompt"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="prompt_type" value="SYSTEM"/>
          <attvalue for="prompt_text" value="rename\_with\_shell = &quot;&quot;&quot;&#xA;&#xA;To rename files which have been added to the chat, use shell commands at the end of your response.&#xA;&#xA;&#xA;&quot;&quot;&quot;"/>
          <attvalue for="prompt_url" value="https://github.com/Aider-AI/aider/blob/7afaa26f8b8b7b56146f0674d2a67e795b616b7c/aider/coders/editblock_prompts.py#L161"/>
