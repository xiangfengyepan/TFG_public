      <node id="repo_CodeFuse_CGM" label="CodeFuse-CGM">
        <attvalues>
          <attvalue for="node_type" value="repo"/>
          <attvalue for="url" value="https://github.com/codefuse-ai/CodeFuse-CGM/blob/2c12754adeb0e4d97d31ea19c2181523fa742d55"/>
