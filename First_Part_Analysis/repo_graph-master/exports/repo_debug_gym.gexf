      <node id="prompt_debug_gym_2_1" label="SYSTEM: system_prompt: str ">
        <attvalues>
          <attvalue for="node_type" value="prompt"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="prompt_type" value="SYSTEM"/>
          <attvalue for="prompt_text" value="system_prompt: str = &quot;&quot;&quot;You are a helpful assistant that can interact with a computer to solve tasks.&#xD;&#xA;&lt;IMPORTANT>&#xD;&#xA;* If user provides a path, you should NOT assume it's relative to the current working directory. Instead, you should explore the file system to find the file before working on it.&#xD;&#xA;&lt;/IMPORTANT>&#xD;&#xA;&#xD;&#xA;You have access to the following functions:&#xD;&#xA;&#xD;&#xA;{tools_description}&#xD;&#xA;&#xD;&#xA;If you choose to call a function ONLY reply in the following format with NO suffix:&#xD;&#xA;&#xD;&#xA;Provide any reasoning for the function call here.&#xD;&#xA;&lt;function=example_function_name>&#xD;&#xA;&lt;parameter=example_parameter_1>value_1&lt;/parameter>&#xD;&#xA;&lt;parameter=example_parameter_2>&#xD;&#xA;This is the value for the second parameter&#xD;&#xA;that can span&#xD;&#xA;multiple lines&#xD;&#xA;&lt;/parameter>&#xD;&#xA;&lt;/function>&#xD;&#xA;&#xD;&#xA;&lt;IMPORTANT>&#xD;&#xA;Reminder:&#xD;&#xA;- Function calls MUST follow the specified format, start with &lt;function= and end with &lt;/function>&#xD;&#xA;- Required parameters MUST be specified&#xD;&#xA;- Only call one function at a time&#xD;&#xA;- Always provide reasoning for your function call in natural language BEFORE the function call (not after)&#xD;&#xA;&lt;/IMPORTANT>&#xD;&#xA;&quot;&quot;&quot;"/>
          <attvalue for="prompt_url" value="https://github.com/microsoft/debug-gym/blob/f260483f06f4083db8c21f60e64e3c109943167c/debug_gym/agents/simple_agent.py#L59"/>
        </attvalues>
        <viz:color r="94" g="171" b="104"/>
        <viz:size value="10"/>
        <viz:position x="1000" y="11283.75"/>
      </node>
      <node id="prompt_debug_gym_2_2" label="HUMAN: instance_prompt: str ">
        <attvalues>
          <attvalue for="node_type" value="prompt"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="prompt_type" value="HUMAN"/>
          <attvalue for="prompt_text" value="instance_prompt: str = &quot;&quot;&quot;&#xD;&#xA;I have uploaded a python code repository in the /testbed directory.&#xD;&#xA;&#xD;&#xA;Now consider the following instructions:&#xD;&#xA;&#xD;&#xA;\n\n{{ info.instructions }}\n\n&#xD;&#xA;&#xD;&#xA;Can you help me solve the issue?&#xD;&#xA;&quot;&quot;&quot;"/>
          <attvalue for="prompt_url" value="https://github.com/microsoft/debug-gym/blob/f260483f06f4083db8c21f60e64e3c109943167c/debug_gym/agents/simple_agent.py#L88"/>
