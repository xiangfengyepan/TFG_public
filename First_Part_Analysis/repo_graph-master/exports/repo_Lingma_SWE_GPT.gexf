      <node id="agent_Lingma_SWE_GPT_3" label="agent_locate_file_class_func">
        <attvalues>
          <attvalue for="node_type" value="agent"/>
          <attvalue for="rawSize" value="21.25"/>
          <attvalue for="agent_name" value="agent_locate_file_class_func"/>
          <attvalue for="agent_type" value="Localizator"/>
          <attvalue for="short_description" value="Agent that is responsability is to use the description or logs in the issue to locate the code files that need to be modified."/>
          <attvalue for="agent_in_repo" value="https://github.com/LingmaTongyi/Lingma-SWE-GPT/blob/888e87dd65a59c84555a04eeb85856cf5fa83936/app/api/agent_locate_file_class_func.py#L1"/>
          <attvalue for="agent_comment" value="null"/>
        </attvalues>
