      <node id="prompt_Lingma_SWE_GPT_1_1" label="SYSTEM_PROMPT = &quot;&quot;&quot;You are a software de">
        <attvalues>
          <attvalue for="node_type" value="prompt"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="prompt_type" value="null"/>
          <attvalue for="prompt_text" value="SYSTEM_PROMPT = &quot;&quot;&quot;You are a software developer maintaining a large project.&#xA;You are working on an issue submitted to your project.&#xA;You ultimate goal is to write a patch that resolves this issue.&#xA;&quot;&quot;&quot;"/>
          <attvalue for="prompt_url" value="https://github.com/LingmaTongyi/Lingma-SWE-GPT/blob/888e87dd65a59c84555a04eeb85856cf5fa83936/app/api/agent_write_patch.py#L25"/>
