          <attvalue for="agent_in_repo" value="https://github.com/LingmaTongyi/Lingma-SWE-GPT/blob/888e87dd65a59c84555a04eeb85856cf5fa83936/app/api/agent_proxy.py#L1"/>
          <attvalue for="agent_comment" value="- no tools: https://github.com/LingmaTongyi/Lingma-SWE-GPT/blob/888e87dd65a59c84555a04eeb85856cf5fa83936/app/api/agent_proxy.py#L120"/>
