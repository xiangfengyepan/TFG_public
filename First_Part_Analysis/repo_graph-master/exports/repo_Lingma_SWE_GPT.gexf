      </node>
      <node id="prompt_Lingma_SWE_GPT_1_2" label="HUMAN: USER_PROMPT_INIT ">
        <attvalues>
          <attvalue for="node_type" value="prompt"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="prompt_type" value="HUMAN"/>
          <attvalue for="prompt_text" value="USER_PROMPT_INIT = &quot;&quot;&quot;Write a patch for the issue, based on the retrieved context. You can import necessary libraries.&#xA;Return the patch in the format below. Within &lt;file>&lt;/file>, replace &quot;...&quot; with actual file path. Within &lt;original>&lt;/original>, replace &quot;...&quot; with the original code snippet from the program. If the original code snippet is too long, you can modify it in multiple sections. Be careful not to modify too long original code at one time to avoid errors. In addition, the original code snippet must not be abbreviated (such as ...), otherwise it cannot be matched to the original location. Within &lt;patched>&lt;/patched>, replace &quot;...&quot; with the fixed version of the original code. When adding orignal code and updated code, pay attention to indentation, as the code is in Python.&#xA;You can write multiple modifications if needed. &#xA;&#xA;# modification 1&#xA;```python&#xA;&lt;file>...&lt;/file>&#xA;&lt;original>...&lt;/original>&#xA;&lt;patched>...&lt;/patched>&#xA;```&#xA;&#xA;# modification 2&#xA;```python&#xA;&lt;file>...&lt;/file>&#xA;&lt;original>...&lt;/original>&#xA;&lt;patched>...&lt;/patched>&#xA;```&#xA;&#xA;# modification 3&#xA;...&#xA;&quot;&quot;&quot;"/>
          <attvalue for="prompt_url" value="https://github.com/LingmaTongyi/Lingma-SWE-GPT/blob/888e87dd65a59c84555a04eeb85856cf5fa83936/app/api/agent_write_patch.py#L31"/>
        </attvalues>
        <viz:color r="113" g="126" b="204"/>
        <viz:size value="10"/>
        <viz:position x="1000" y="11666.25"/>
      </node>
