      <node id="node_Prometheus_4" label="BugReproducingStructuredNode">
        <attvalues>
          <attvalue for="node_type" value="agent_node"/>
          <attvalue for="rawSize" value="15"/>
          <attvalue for="agent_name" value="BugReproducingStructuredNode"/>
          <attvalue for="agent_type" value="null"/>
          <attvalue for="short_description" value="Agent that verifies if a test properly reproduces a reported bug."/>
          <attvalue for="agent_in_repo" value="https://github.com/EuniAI/Prometheus/blob/652848606683753952a18b8dc0312584f2c67d99/prometheus/lang_graph/nodes/bug_reproducing_structured_node.py#L30"/>
          <attvalue for="agent_comment" value="null"/>
        </attvalues>
