          <attvalue for="agent_type" value="null"/>
          <attvalue for="short_description" value="A specialized editing agent responsible for implementing precise changes to files."/>
          <attvalue for="agent_in_repo" value="https://github.com/EuniAI/Prometheus/blob/652848606683753952a18b8dc0312584f2c67d99/prometheus/lang_graph/nodes/edit_node.py#L22"/>
