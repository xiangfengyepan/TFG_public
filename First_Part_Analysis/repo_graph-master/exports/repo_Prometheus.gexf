      <node id="node_Prometheus_5" label="BugReproducingWriteNode">
        <attvalues>
          <attvalue for="node_type" value="agent_node"/>
          <attvalue for="rawSize" value="15"/>
          <attvalue for="agent_name" value="BugReproducingWriteNode"/>
          <attvalue for="agent_type" value="null"/>
          <attvalue for="short_description" value="Agent writes focused a single test case to reproduce software bugs.&#xA;Given an issue description, create a single minimal test with MINIMAL number of assertions&#xA;that demonstrates the problem."/>
          <attvalue for="agent_in_repo" value="https://github.com/EuniAI/Prometheus/blob/652848606683753952a18b8dc0312584f2c67d99/prometheus/lang_graph/nodes/bug_reproducing_write_node.py#L14"/>
          <attvalue for="agent_comment" value="null"/>
