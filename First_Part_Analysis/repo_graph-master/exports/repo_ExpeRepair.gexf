    <nodes>
      <node id="repo_ExpeRepair" label="ExpeRepair">
        <attvalues>
          <attvalue for="node_type" value="repo"/>
          <attvalue for="url" value="https://github.com/ExpeRepair/ExpeRepair/blob/5594f2c02c23d2bf204e5db76949425e6d170922"/>
          <attvalue for="commits" value="3"/>
          <attvalue for="releases" value="0"/>
          <attvalue for="stars" value="106"/>
          <attvalue for="analyzed" value="TRUE"/>
          <attvalue for="publication" value="not found"/>
          <attvalue for="framework" value="framework itself"/>
          <attvalue for="dependency_graph" value="Disable"/>
          <attvalue for="has_agents" value="TRUE"/>
          <attvalue for="num_agents" value="4"/>
          <attvalue for="topology_description" value="The ExpeRepair framework utilizes a dual-memory, multi-agent topology to automate repository-level program repair through continuous learning. At its core, an execution layer consisting of a collaborative Test Agent and Patch Agent interacts with the codebase to iteratively generate tests, localize faults, and validate fixes. During the Initial Phase, these agents resolve seed issues, allowing the system to extract concrete, step-by-step repair demonstrations into an Episodic Memory and synthesize high-level, generalized strategies into a Semantic Memory. In the Inference Phase, when confronting a new issue, a Dynamic Prompt Composition module retrieves these stored experiences, feeding context-aware, experience-driven instructions back to the agents to efficiently guide them toward generating a final, validated patch."/>
          <attvalue for="topology_file" value="ExpeRepair_topology_generated.png"/>
          <attvalue for="topology_type" value="Centralized"/>
          <attvalue for="topology_url" value="https://github.com/ExpeRepair/ExpeRepair/blob/5594f2c02c23d2bf204e5db76949425e6d170922/ExpeRepair-v1.0/api/review_manage_ase.py#L17"/>
          <attvalue for="programming_language" value="Python, Shell"/>
          <attvalue for="autonomy_rating" value="1"/>
          <attvalue for="autonomy_description" value="1 – Orchestrated: execution decided by software workflow or human"/>
          <attvalue for="repo_comments" value="- Review manager -> (patch agentand reproducer agent)&#xA;- Search manager -> (search agent)&#xA;- ## 🙏 Acknowledgement &#xA;&#xA;* [SWE-bench](https://www.swebench.com/)&#xA;* [auto-code-rover](https://github.com/AutoCodeRoverSG/auto-code-rover)&#xA;* [Agentless](https://github.com/OpenAutoCoder/Agentless/)"/>
          <attvalue for="rawSize" value="32.5"/>
        </attvalues>
        <viz:color r="102" g="170" b="96"/>
        <viz:size value="32.5"/>
        <viz:position x="-289.7777478867204" y="77.64571353075644"/>
      </node>
      <node id="agent_ExpeRepair_0" label="TestAgent">
        <attvalues>
          <attvalue for="node_type" value="agent"/>
