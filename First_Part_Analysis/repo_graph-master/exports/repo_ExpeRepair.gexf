          <attvalue for="agent_type" value="Bug reproduction"/>
          <attvalue for="short_description" value="responsible for writing a test script for an issue reported in your GitHub project"/>
          <attvalue for="agent_in_repo" value="https://github.com/ExpeRepair/ExpeRepair/blob/5594f2c02c23d2bf204e5db76949425e6d170922/ExpeRepair-v1.0/agents/agent_reproducer.py#L179"/>
