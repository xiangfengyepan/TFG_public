      <node id="agent_DARS_Agent_1" label="DARSAgent">
        <attvalues>
          <attvalue for="node_type" value="agent"/>
          <attvalue for="rawSize" value="40"/>
          <attvalue for="agent_name" value="DARSAgent"/>
          <attvalue for="agent_type" value="Base agent"/>
          <attvalue for="short_description" value="Agent that execute a tree of posibilities actions"/>
          <attvalue for="agent_in_repo" value="https://github.com/darsagent/DARS-Agent/blob/eab35168a90b7dc5b5a05a29d7d41993cdb74bdf/dars-agent/sweagent/agent/dars_agent.py#L344"/>
          <attvalue for="agent_comment" value="- use agent hook to debug diferent steps of the agent run"/>
