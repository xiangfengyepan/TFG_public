      <node id="agent_OrcaLoca_0" label="OrcarAgent">
        <attvalues>
          <attvalue for="node_type" value="agent"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="agent_name" value="OrcarAgent"/>
          <attvalue for="agent_type" value="Enviorment setup"/>
          <attvalue for="short_description" value="&quot;&quot;&quot;&#xD;&#xA;    Orcar agent worker.&#xD;&#xA;    Environment container lives during agent lifetime;&#xD;&#xA;    Dataset is independent from agent;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    Example call:&#xD;&#xA;    agent = OrcarAgent(args=args, llm=llm, final_stage='Search')&#xD;&#xA;    for inst in ds:&#xD;&#xA;        agent.run(dict(inst))&#xD;&#xA;    &quot;&quot;&quot;"/>
          <attvalue for="agent_in_repo" value="https://github.com/fishmingyu/OrcaLoca/blob/37db289be2dc3b7432183fe08b3f06becce87c27/Orcar/agent.py#L43"/>
          <attvalue for="agent_comment" value="null"/>
        </attvalues>
        <viz:color r="102" g="170" b="96"/>
        <viz:size value="10"/>
        <viz:position x="-586.0595287925235" y="-128.5854918390303"/>
      </node>
      <node id="agent_OrcaLoca_1" label="CodeScorer">
