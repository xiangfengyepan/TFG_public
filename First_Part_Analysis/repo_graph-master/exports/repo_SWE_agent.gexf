      <node id="prompt_SWE_agent_0_2" label="PROXY: instance_template: str ">
        <attvalues>
          <attvalue for="node_type" value="prompt"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="prompt_type" value="PROXY"/>
          <attvalue for="prompt_text" value="instance_template: str = dedent(&quot;&quot;&quot;&#xA;    We're solving the following problem&#xA;&#xA;    &lt;problem_statement>&#xA;    {{problem_statement}}&#xA;    &lt;/problem_statement>&#xA;&#xA;    So far, we've performed the following actions:&#xA;&#xA;    &lt;trajectory>&#xA;    {{traj}}&#xA;    &lt;/trajectory>&#xA;    &quot;&quot;&quot;)&#xA;&#xA;    comparison_template: str = dedent(&quot;&quot;&quot;&#xA;    Two junior developers suggested the following actions:&#xA;&#xA;    &lt;thought1>&#xA;    {{thought1}}&#xA;    &lt;/thought1>&#xA;&#xA;    &lt;action1>&#xA;    {{action1}}&#xA;    &lt;/action1>&#xA;&#xA;    &lt;thought2>&#xA;    {{thought2}}&#xA;    &lt;/thought2>&#xA;&#xA;    &lt;action2>&#xA;    {{action2}}&#xA;    &lt;/action2>&#xA;&#xA;    Please compare the two actions in detail.&#xA;&#xA;    Which action should we take?&#xA;&#xA;    If you think the first action is better, respond with &quot;first&quot;.&#xA;    If you think the second action is better, respond with &quot;second&quot;.&#xA;&#xA;    The last line of your response MUST be &quot;first&quot; or &quot;second&quot;.&#xA;    &quot;&quot;&quot;)"/>
          <attvalue for="prompt_url" value="https://github.com/SWE-agent/SWE-agent/blob/39e2931a81c8698265e2db40ec4f3911b630d942/sweagent/agent/action_sampler.py#L106"/>
        </attvalues>
        <viz:color r="119" g="122" b="204"/>
