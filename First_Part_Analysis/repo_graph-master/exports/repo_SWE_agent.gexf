        <attvalues>
          <attvalue for="node_type" value="prompt"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="prompt_type" value="SYSTEM"/>
          <attvalue for="prompt_text" value="system_template: str = &quot;&quot;&quot;&lt;setting>You are an expert software engineer overseeing junior developers. They suggest actions to take to solve a problem. You must choose the best action to take. &lt;/setting>&quot;&quot;&quot;"/>
