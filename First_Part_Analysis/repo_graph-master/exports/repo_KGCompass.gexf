          <attvalue for="agent_type" value="Locator"/>
          <attvalue for="short_description" value="localize the bug based on the issue statement, and then generate *SEARCH/REPLACE* edits to fix the issue."/>
          <attvalue for="agent_in_repo" value="https://github.com/GLEAM-Lab/KGCompass/blob/e79c97b73c8ab12e52b3e6c20be949f48241e084/kgcompass/repair.py#L77"/>
