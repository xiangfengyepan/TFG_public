        <attvalues>
          <attvalue for="node_type" value="tool"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="tool_url" value="https://github.com/AutoCodeRoverSG/auto-code-rover/blob/585d3e639aeda58ef0b6a151dd1cc2721a94d267/app/model/common.py#L136"/>
