      </node>
      <node id="prompt_Lingxi_4_1" label="SYSTEM: DEV_KNOWLEDGE_ANALYSIS_SYSTEM_PROMPT ">
        <attvalues>
          <attvalue for="node_type" value="prompt"/>
          <attvalue for="rawSize" value="10"/>
          <attvalue for="prompt_type" value="SYSTEM"/>
          <attvalue for="prompt_text" value="DEV_KNOWLEDGE_ANALYSIS_SYSTEM_PROMPT = &quot;&quot;&quot;&#xD;&#xA;You are a helpful assistant. You are given a description of a issue and it's asscoiated patch. You need to analyze the issue and the patch to provide a detailed analysis of the issue.&#xD;&#xA;&quot;&quot;&quot;"/>
          <attvalue for="prompt_url" value="https://github.com/lingxi-agent/Lingxi/blob/fe0b1d36323234c3c90eaa05a82ffc53c77064f9/src/agent/prompt/dev_knowledge_prompts.py#L1"/>
        </attvalues>
        <viz:color r="131" g="119" b="201"/>
        <viz:size value="10"/>
        <viz:position x="-664.8745412171212" y="606.5821003304685"/>
