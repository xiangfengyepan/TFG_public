          <attvalue for="agent_in_repo" value="https://github.com/lingxi-agent/Lingxi/blob/fe0b1d36323234c3c90eaa05a82ffc53c77064f9/src/agent/tool_set/dev_knowledge.py#L207"/>
          <attvalue for="agent_comment" value="- use create_react_agent from langgraph.prebuilt is decapres, now use create_agent from langchain.agents"/>
        </attvalues>
        <viz:color r="82" g="174" b="117"/>
