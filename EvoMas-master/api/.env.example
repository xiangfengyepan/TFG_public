# API server configuration. Copy to `.env` to override defaults.
# Read by:
#   - scripts/start_api.ps1   (host/port for uvicorn)
#   - api/server.py   (load_dotenv → os.environ)

# Bind address. Use 0.0.0.0 to expose on the LAN, 127.0.0.1 for local-only.
API_HOST=0.0.0.0

# TCP port the FastAPI server listens on.
# If you change this, also update the frontend's BASE URL in
# app/src/app/services/api.service.ts (currently hardcoded to :8000).
API_PORT=8000
