{
  "id": "tree",
  "description": "Hierarchical tree: locator branches to two parallel patchers (diversified by seed/temperature) that converge on a single reviewer, then finalizer. Pure DAG; static fan-out / fan-in.",
  "entry": "locator",
  "end": "finalizer",
  "edges": [
    {"from": "locator", "to": "patcher_a"},
    {"from": "locator", "to": "patcher_b"},
    {"from": "patcher_a", "to": "reviewer"},
    {"from": "patcher_b", "to": "reviewer"},
    {"from": "reviewer", "to": "finalizer"}
  ],
  "agents": {
    "locator": {
      "class": "LocatorAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 8192, "stream": true,
      "temperature": 0.2, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 512, "stop": ["</files>"],
      "max_iters": 6
    },
    "patcher_a": {
      "class": "PatcherAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 16384, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 2048, "stop": ["</patch>"],
      "max_iters": 12,
      "fallback": {"enabled": true, "guarantee_change": true}
    },
    "patcher_b": {
      "class": "PatcherAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 16384, "stream": true,
      "temperature": 0.2, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 42,
      "num_predict": 2048, "stop": ["</patch>"],
      "max_iters": 12,
      "fallback": {"enabled": true, "guarantee_change": true}
    },
    "reviewer": {
      "class": "ReviewerAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 4096, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 1024, "stop": ["</review>"],
      "max_iters": 6
    },
    "finalizer": {
      "class": "HelperProxyAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 4096, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 512, "stop": [],
      "max_iters": 4
    }
  }
}
