{
  "id": "cycle",
  "description": "Must-retry topology. locator -> patcher_draft (read-only tools, cannot mutate workspace) -> reviewer -> router(Orchestrator) -> {patcher_final (cycle target, has full apply_description_fix toolkit), finalizer}. Edge order makes reviewer.predecessor_name='patcher_final' so the first pass sees an empty PatcherAgent.OUTPUT_DEFAULT, the router routes back to patcher_final, the real fix lands, the second reviewer pass sees the diff, and the router routes to finalizer. The cycle is mechanically required — the first patcher physically cannot apply a patch.",
  "entry": "locator",
  "end": "finalizer",
  "edges": [
    {"from": "locator", "to": "patcher_draft"},
    {"from": "patcher_final", "to": "reviewer"},
    {"from": "patcher_draft", "to": "reviewer"},
    {"from": "reviewer", "to": "router"},
    {"from": "router", "to": "patcher_final"},
    {"from": "router", "to": "finalizer"}
  ],
  "agents": {
    "locator": {
      "class": "LocatorAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 8192, "stream": true,
      "temperature": 0.2, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 512, "stop": ["</files>"],
      "max_iters": 6
    },
    "patcher_draft": {
      "class": "PatcherAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 16384, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 2048, "stop": ["</patch>"],
      "max_iters": 4,
      "tools": [
        {"name": "read_file", "params": {}},
        {"name": "list_files", "params": {}},
        {"name": "search_code", "params": {}},
        {"name": "generate_diff", "params": {}}
      ]
    },
    "patcher_final": {
      "class": "PatcherAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 16384, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 2048, "stop": ["</patch>"],
      "max_iters": 12,
      "fallback": {"enabled": true, "guarantee_change": true}
    },
    "reviewer": {
      "class": "ReviewerAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 4096, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 1024, "stop": ["</review>"],
      "max_iters": 6
    },
    "router": {
      "class": "OrchestratorAgent",
      "model": "ollama/qwen3.5:9b", "think": false, "num_ctx": 2048, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 32, "stop": [],
      "max_iters": 1,
      "prompts": {
        "user": "The reviewer just produced this verdict:\n\n{predecessor}\n\nDecide the next step.\n- Reply 'patcher_final' if the verdict indicates the patch is missing, empty, not applied, broken, or fails review.\n- Reply 'finalizer' if and only if the verdict explicitly confirms the patch is correct, applied, and resolves the issue.\n- When the verdict is empty, blank, ambiguous, or just says 'no patch to review', reply 'patcher_final'.\nReply with EXACTLY ONE word: 'patcher_final' or 'finalizer'. No other text."
      }
    },
    "finalizer": {
      "class": "HelperProxyAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 4096, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 512, "stop": [],
      "max_iters": 4
    }
  }
}
