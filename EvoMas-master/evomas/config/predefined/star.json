{
  "id": "star",
  "description": "Star topology with LLM-driven hub: locator -> Orchestrator hub -> {patcher_a, patcher_b} (hub LLM picks at least one) -> finalizer. graph_builder installs a conditional edge that reads state['hub'] for whole-word spoke names; falls back to all spokes on a parser miss.",
  "entry": "locator",
  "end": "finalizer",
  "edges": [
    {"from": "locator", "to": "hub"},
    {"from": "hub", "to": "patcher_a"},
    {"from": "hub", "to": "patcher_b"},
    {"from": "patcher_a", "to": "finalizer"},
    {"from": "patcher_b", "to": "finalizer"}
  ],
  "agents": {
    "locator": {
      "class": "LocatorAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 8192, "stream": true,
      "temperature": 0.2, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 512, "stop": ["</files>"],
      "max_iters": 6
    },
    "hub": {
      "class": "OrchestratorAgent",
      "model": "ollama/qwen3.5:9b", "think": false, "num_ctx": 2048, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 64, "stop": [],
      "max_iters": 1,
      "prompts": {
        "user": "## Issue\n{issue}\n\n## Workspace\n{workspace}\n\nThe available next agents are: patcher_a, patcher_b.\n- patcher_a is the deterministic path (temperature 0.0, seed 0); pick it for short description / error-message bugs.\n- patcher_b explores with higher temperature (0.2, seed 42); pick it when the bug seems to need real code-logic changes.\nReply with ONE line containing either 'patcher_a', 'patcher_b', or both names space-separated. No other text."
      }
    },
    "patcher_a": {
      "class": "PatcherAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 16384, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 2048, "stop": ["</patch>"],
      "max_iters": 12,
      "fallback": {"enabled": true, "guarantee_change": true}
    },
    "patcher_b": {
      "class": "PatcherAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 16384, "stream": true,
      "temperature": 0.2, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 42,
      "num_predict": 2048, "stop": ["</patch>"],
      "max_iters": 12,
      "fallback": {"enabled": true, "guarantee_change": true}
    },
    "finalizer": {
      "class": "HelperProxyAgent",
      "model": "ollama/qwen3.5:9b", "think": true, "num_ctx": 4096, "stream": true,
      "temperature": 0.0, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 512, "stop": [],
      "max_iters": 4
    }
  }
}
