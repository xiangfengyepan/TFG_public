{
  "id": "star",
  "description": "Type-driven linear chain: localizator → patcher → reviewer → ensembler. Each agent inherits prompts/tools from its type class under evomas/agents/types/ — no bespoke Python.",
  "entry": "localizator",
  "end": "ensembler",
  "edges": [
    {"from": "localizator", "to": "patcher"},
    {"from": "patcher",     "to": "reviewer"},
    {"from": "reviewer",    "to": "ensembler"}
  ],
  "agents": {
    "localizator": {
      "class": "LocalizatorAgent",
      "model": "qwen3.5:9b", "think": false, "num_ctx": 8192, "stream": true,
      "temperature": 0.4, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 1024, "stop": ["</files>"],
      "max_iters": 8
    },
    "patcher": {
      "class": "PatcherAgent",
      "model": "qwen3.5:9b", "think": false, "num_ctx": 16384, "stream": true,
      "temperature": 0.2, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 2048, "stop": ["</patch>"],
      "max_iters": 12,
      "fallback": {"enabled": true, "guarantee_change": true}
    },
    "reviewer": {
      "class": "ReviewerAgent",
      "model": "qwen3.5:9b", "think": false, "num_ctx": 4096, "stream": true,
      "temperature": 0.2, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 512, "stop": ["</review>"],
      "max_iters": 6
    },
    "ensembler": {
      "class": "HelperProxyAgent",
      "model": "qwen3.5:9b", "think": false, "num_ctx": 4096, "stream": true,
      "temperature": 0.2, "top_k": 40, "top_p": 0.9, "min_p": 0.0,
      "repeat_penalty": 1.1, "repeat_last_n": 64, "seed": 0,
      "num_predict": 512, "stop": [],
      "max_iters": 4
    }
  }
}
