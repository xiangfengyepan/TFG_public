{
  "id": "star_centralized",
  "description": "True centralized star: hub (Orchestrator) at the center with bidirectional edges to locator, patcher, reviewer for iteration, plus a one-way edge to finalizer for termination. The hub's conditional router picks a spoke to continue iterating, or `finalizer` to terminate. The finalizer (HelperProxyAgent) emits the canonical workspace diff as the run's final patch.",
  "entry": "hub",
  "end": "finalizer",
  "edges": [
    {
      "from": "hub",
      "to": "locator"
    },
    {
      "from": "locator",
      "to": "hub"
    },
    {
      "from": "hub",
      "to": "patcher"
    },
    {
      "from": "patcher",
      "to": "hub"
    },
    {
      "from": "hub",
      "to": "reviewer"
    },
    {
      "from": "reviewer",
      "to": "hub"
    },
    {
      "from": "hub",
      "to": "finalizer"
    }
  ],
  "agents": {
    "hub": {
      "class": "Orchestrator",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 2048,
      "stream": true,
      "temperature": 0,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 1024,
      "stop": [],
      "max_iters": 1,
      "prompts": {
        "system": "You dispatch the next worker in a 4-stage SWE-bench pipeline (locator -> patcher -> reviewer -> finalizer). You receive the pipeline state and answer with EXACTLY ONE word: the next worker to run.",
        "user": "Apply these rules IN ORDER. Stop at the first rule that matches.\n\n1. If `locator` output is EMPTY -> answer: locator\n2. If `patcher` output is EMPTY -> answer: patcher\n3. If `reviewer` output is EMPTY -> answer: reviewer\n4. Otherwise -> answer: finalizer\n\n--- pipeline state (empty between `<<<` and `>>>` means that worker hasn't run yet) ---\nlocator output:  <<<{locator}>>>\npatcher output:  <<<{patcher}>>>\nreviewer output: <<<{reviewer}>>>\n--- end state ---\n\nAnswer with one word from: locator, patcher, reviewer, finalizer."
      }
    },
    "locator": {
      "class": "LocatorAgent",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 8192,
      "stream": true,
      "temperature": 0.2,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 512,
      "stop": [
        "</files>"
      ],
      "max_iters": 6
    },
    "patcher": {
      "class": "PatcherAgent",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 16384,
      "stream": true,
      "temperature": 0,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 2048,
      "stop": [
        "</patch>"
      ],
      "max_iters": 12,
      "fallback": {
        "enabled": true,
        "guarantee_change": true
      }
    },
    "reviewer": {
      "class": "ReviewerAgent",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 4096,
      "stream": true,
      "temperature": 0,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 1024,
      "stop": [
        "</review>"
      ],
      "max_iters": 6
    },
    "finalizer": {
      "class": "HelperProxyAgent",
      "model": "ollama/qwen3.5:9b",
      "think": true,
      "num_ctx": 4096,
      "stream": true,
      "temperature": 0,
      "top_k": 40,
      "top_p": 0.9,
      "min_p": 0,
      "repeat_penalty": 1.1,
      "repeat_last_n": 64,
      "seed": 0,
      "num_predict": 512,
      "stop": [],
      "max_iters": 4
    }
  }
}