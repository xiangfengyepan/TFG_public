# EvoMas runtime environment.
# Copy to `.env` and fill in your own values.

# Ollama HTTP endpoint used by every agent's LLM calls.
# Default if unset: http://localhost:11434
OLLAMA_BASE_URL="http://localhost:11434"

# Optional: ollama model used by the integration tests in evomas/tests/.
# Default if unset: qwen3.5:9b
# OLLAMA_MODEL="qwen3.5:9b"

# Optional: Weights & Biases API key for `evomas.utils.weave_init`.
# Only required if you call `init_weave()` (currently disabled in
# `scripts/generate_evomas_predictions.py`). Leave blank to skip W&B init.
# WANDB_API_KEY=""

# Optional: where predictions + evaluations are written. Relative values are
# resolved against the repo root, so `results` and `<repo>/results` mean the
# same thing. Default if unset: <repo root>/results.
# RESULTS_DIR="results"
